{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "abricocotier-v2",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	// Keep environment variables (secrets, vars) across deploys
	"keep_vars": true,
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "abricocotier-v2-d1",
			"database_id": "1533ebc3-7e3d-4d9b-a19f-7011b7aece4c",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "abricocotier-v2-r2",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
